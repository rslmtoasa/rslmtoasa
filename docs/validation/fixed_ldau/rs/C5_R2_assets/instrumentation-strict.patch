+   subroutine r2_diag_coefficients(this, iter)
+      use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
+      class(self), intent(in) :: this
+      integer, intent(in) :: iter
+      integer :: i,j,k,l
+      real(rp) :: v
+      if (.not. allocated(this%recursion%a_b) .or. .not. allocated(this%recursion%b2_b)) return
+      do l=1,size(this%recursion%a_b,4); do k=1,size(this%recursion%a_b,3); do j=1,size(this%recursion%a_b,2); do i=1,size(this%recursion%a_b,1)
+         if (.not. ieee_is_finite(real(this%recursion%a_b(i,j,k,l),rp)) .or. .not. ieee_is_finite(aimag(this%recursion%a_b(i,j,k,l)))) then
+            write(*,'(a,i0,a,4(i0,1x))') 'R2_FIRST_NONFINITE iter=',iter,' quantity=A index=',i,j,k,l
+            return
+         end if
+      end do; end do; end do; end do
+      do l=1,size(this%recursion%b2_b,4); do k=1,size(this%recursion%b2_b,3); do j=1,size(this%recursion%b2_b,2); do i=1,size(this%recursion%b2_b,1)
+         if (.not. ieee_is_finite(real(this%recursion%b2_b(i,j,k,l),rp)) .or. .not. ieee_is_finite(aimag(this%recursion%b2_b(i,j,k,l)))) then
+            write(*,'(a,i0,a,4(i0,1x))') 'R2_FIRST_NONFINITE iter=',iter,' quantity=B2 index=',i,j,k,l
+            return
+         end if
+      end do; end do; end do; end do
+      do l=1,min(size(this%recursion%b2_b,4),this%lattice%nrec); do k=1,size(this%recursion%b2_b,3); do i=1,min(size(this%recursion%b2_b,1),size(this%recursion%b2_b,2))
+         v=real(this%recursion%b2_b(i,i,k,l),rp)
+         if (v < 0.0_rp) then
+            write(*,'(a,i0,a,3(i0,1x),es24.16)') 'R2_OUT_OF_RANGE iter=',iter,' quantity=B2_diag index=',i,k,l,v
+            return
+         end if
+      end do; end do; end do
+      write(*,'(a,i0,a)') 'R2_FINITE iter=',iter,' quantity=A,B2'
+   end subroutine r2_diag_coefficients
+
+   subroutine r2_diag_qmoments(this, iter, stage)
+      use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
+      class(self), intent(in) :: this
+      integer, intent(in) :: iter
+      character(len=*), intent(in) :: stage
+      integer :: i,j
+      if (trim(stage) == 'MIXED_Q') then
+         if (.not. allocated(this%mix%qia)) return
+         do j=1,size(this%mix%qia,2); do i=1,size(this%mix%qia,1)
+            if (.not. ieee_is_finite(this%mix%qia(i,j))) then
+               write(*,'(a,i0,2a,2(i0,1x))') 'R2_FIRST_NONFINITE iter=',iter,' quantity=',trim(stage),' index=',i,j
+               return
+            end if
+         end do; end do
+         write(*,'(a,i0,2a,es24.16,1x,es24.16)') 'R2_FINITE iter=',iter,' quantity=',trim(stage), &
+            minval(this%mix%qia),maxval(this%mix%qia)
+      else
+         if (.not. allocated(this%mix%qia_new)) return
+         do j=1,size(this%mix%qia_new,2); do i=1,size(this%mix%qia_new,1)
+            if (.not. ieee_is_finite(this%mix%qia_new(i,j))) then
+               write(*,'(a,i0,2a,2(i0,1x))') 'R2_FIRST_NONFINITE iter=',iter,' quantity=',trim(stage),' index=',i,j
+               return
+            end if
+         end do; end do
+         write(*,'(a,i0,2a,es24.16,1x,es24.16)') 'R2_FINITE iter=',iter,' quantity=',trim(stage), &
+            minval(this%mix%qia_new),maxval(this%mix%qia_new)
+      end if
+   end subroutine r2_diag_qmoments
+
 end module self_mod

 submodule(recursion_mod) recursion_haydock
 
+   logical, save :: c3_a3_started = .false.
+   logical, save :: c3_terminator_written = .false.
+
 contains
+
+   logical function c3_audit_enabled()
+      character(len=16) :: value
+      integer :: status
+      value = ''
+      call get_environment_variable('RSLMTO_C3_A3_AUDIT', value, status=status)
+      c3_audit_enabled = status == 0 .and. trim(value) == '1'
+   end function c3_audit_enabled
+
+   subroutine c3_positive_sqrt_block(beta2, beta)
+      use basis_mod, only: nb
+      complex(rp), intent(in) :: beta2(nb,nb)
+      complex(rp), intent(out) :: beta(nb,nb)
+      complex(rp) :: eigvec(nb,nb), work(nb*nb), lam(nb,nb), temp(nb,nb)
+      real(rp) :: eigval(nb), rwork(3*nb-2)
+      integer :: info, i
+      eigvec = beta2
+      call zheev('v', 'u', nb, eigvec, nb, eigval, work, nb*nb, rwork, info)
+      if (info /= 0) then
+         beta = (0.0_rp, 0.0_rp)
+         return
+      end if
+      lam = (0.0_rp, 0.0_rp)
+      do i = 1, nb
+         lam(i,i) = cmplx(sqrt(max(0.0_rp, eigval(i))), kind=kind(0.0d0))
+      end do
+      call zgemm('n', 'n', nb, nb, nb, cone, eigvec, nb, lam, nb, czero, temp, nb)
+      call zgemm('n', 'c', nb, nb, nb, cone, temp, nb, eigvec, nb, czero, beta, nb)
+   end subroutine c3_positive_sqrt_block
+
+   subroutine c3_write_coefficients(this, site, original_lld, alpha, beta2)
+      use basis_mod, only: nb
+      class(recursion), intent(in) :: this
+      integer, intent(in) :: site, original_lld
+      complex(rp), intent(in) :: alpha(:,:,:), beta2(:,:,:)
+      character(len=1024) :: path
+      integer :: unit, status, k, ii, jj, i, j, itype
+      complex(rp) :: beta(nb,nb)
+      itype = this%lattice%iz(site)
+      path = 'c3_a3_coefficients.dat'
+      call get_environment_variable('RSLMTO_C3_A3_AUDIT_FILE', path, status=status)
+      if (status /= 0 .or. len_trim(path) == 0) path = 'c3_a3_coefficients.dat'
+      if (c3_a3_started) then
+         open(newunit=unit, file=trim(path), status='old', position='append', action='write', iostat=status)
+      else
+         open(newunit=unit, file=trim(path), status='replace', action='write', iostat=status)
+         c3_a3_started = .true.
+      end if
+      if (status /= 0) return
+      write(unit,'(a,1x,i0,1x,i0,1x,i0,1x,i0)') 'COEFF_META_BLOCK', site, itype, original_lld, size(alpha,3)
+      write(unit,'(a,1x,a,1x,a,1x,a)') 'UNITS', 'A=Ry', 'B=Ry', 'B2=Ry^2'
+      do k = 0, original_lld
+         call c3_positive_sqrt_block(beta2(:,:,k+1), beta)
+         do ii = 1, nb
+            i = ii
+            do jj = 1, nb
+               j = jj
+               write(unit,'(a,1x,i0,1x,i0,1x,i0,1x,i0,1x,i0,1x,4(es26.17e3,1x))') &
+                  'COEFF', site, itype, k, i, j, real(alpha(i,j,k+1),rp), aimag(alpha(i,j,k+1)), &
+                  real(beta(i,j),rp), aimag(beta(i,j))
+               write(unit,'(a,1x,i0,1x,i0,1x,i0,1x,i0,1x,i0,1x,2(es26.17e3,1x))') &
+                  'COEFF_B2', site, itype, k, i, j, real(beta2(i,j,k+1),rp), aimag(beta2(i,j,k+1))
+            end do
+         end do
+      end do
+      close(unit)
+   end subroutine c3_write_coefficients
+

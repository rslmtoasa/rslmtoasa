+   subroutine c3_write_terminator(this, na, ll, ldim, Acoef_b, B2coef_b, a_inf, b_inf, a_inf0, b_inf0)
+      use basis_mod, only: nb
+      use mpi_mod, only: rank
+      class(recursion), intent(in) :: this
+      integer, intent(in) :: na, ll, ldim
+      complex(rp), intent(in) :: Acoef_b(ldim,ldim,ll,na), B2coef_b(ldim,ldim,ll,na)
+      real(rp), intent(in) :: a_inf(ldim,ldim,na), b_inf(ldim,ldim,na)
+      real(rp), intent(in) :: a_inf0(na), b_inf0(na)
+      character(len=1024) :: path
+      integer :: unit, status, n, site, itype, ii, jj, i, j
+      complex(rp) :: beta(nb,nb)
+      if (rank /= 0) return
+      path = 'c3_a3_coefficients.dat'
+      call get_environment_variable('RSLMTO_C3_A3_AUDIT_FILE', path, status=status)
+      if (status /= 0 .or. len_trim(path) == 0) path = 'c3_a3_coefficients.dat'
+      open(newunit=unit, file=trim(path), status='unknown', position='append', action='write', iostat=status)
+      if (status /= 0) return
+      write(unit,'(a,3(1x,i0))') 'TERM_SHAPE', ldim, ll, na
+      write(unit,'(a,1x,a,1x,a,1x,a,1x,a,1x,a)') &
+         'TERM_UNITS', 'A_INF=Ry', 'B_INF=Ry', 'A_LLD=Ry', 'B_LLD=Ry', 'B2_LLD=Ry^2'
+      do n = 1, na
+         site = 0; itype = 0
+         if (n <= this%lattice%nrec) then
+            site = this%lattice%irec(n)
+            if (site >= 1 .and. site <= this%lattice%kk) itype = this%lattice%iz(site)
+         end if
+         write(unit,'(a,1x,i0,1x,i0,1x,i0,1x,i0)') 'TERM_META', n, site, itype, ll
+         call c3_positive_sqrt_block(B2coef_b(:,:,ll,n), beta)
+         do ii = 1, nb
+            i = ii
+            do jj = 1, nb
+               j = jj
+               write(unit,'(a,1x,i0,1x,i0,1x,i0,1x,i0,1x,8(es26.17e3,1x))') &
+                  'TERM', n, i, j, 1, a_inf(i,j,n), b_inf(i,j,n), &
+                  real(Acoef_b(i,j,ll,n),rp), aimag(Acoef_b(i,j,ll,n)), &
+                  real(beta(i,j),rp), aimag(beta(i,j)), &
+                  real(B2coef_b(i,j,ll,n),rp), aimag(B2coef_b(i,j,ll,n))
+            end do
+         end do
+         write(unit,'(a,1x,i0,1x,2(es26.17e3,1x))') 'TERM_AVG', n, a_inf0(n), b_inf0(n)
+      end do
+      close(unit)
+   end subroutine c3_write_terminator
 

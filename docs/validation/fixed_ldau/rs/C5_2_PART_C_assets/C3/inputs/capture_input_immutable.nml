&calculation
pre_processing = 'bravais'
verbose = T
/
&lattice
rc = 080 ! radius cut. We could think about setting a default
alat = 2.86120 ! lattice parapeter
crystal_sym = 'bcc' ! options are bcc, fcc and hcp so far.
wav = 1.40880
ntype = 1
ct(1) = 3.0d0
r2 = 9.00d0
/
&atoms
database = './'
label(1) = 'Fe'
/
&self

nstep = 1
conv_thr = 1.0e-30
use_kspace = .false.
/
&energy

fermi = -0.069252
fix_fermi = .false.
energy_min = -1.0
energy_max = 1.3
channels_ldos = 2500
/
&control

calctype = 'B'
nsp = 1
lld = 150
recur = 'chebyshev'
fresh_start = .false.
/
&mix

beta = 0.005
mixtype = 'broyden'
/

&hamiltonian

hubbard_u_general(1,3) = 2.0
hubbard_j_general(1,3) = 0.0
hubbard_u_potential_form = 'liechtenstein'
hubbard_radial_moments = 'local'
/

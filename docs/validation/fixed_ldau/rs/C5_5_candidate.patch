+program test_auto_impurity_local_mode
+   use math_mod, only: auto_impurity_local_host_eligible
+   implicit none
+   logical :: eligible
+   character(len=128) :: reason
+   logical :: active(3)
+   character(len=16) :: mode(3)
+
+   active = [.true., .true., .false.]
+   mode = ['local           ', 'local           ', 'spectral        ']
+   call auto_impurity_local_host_eligible(.true., active, mode, eligible, reason)
+   call check(eligible, 'all U-carrying host files local')
+
+   mode(2) = 'spectral'
+   call auto_impurity_local_host_eligible(.true., active, mode, eligible, reason)
+   call check(.not. eligible .and. index(reason, 'spectral') > 0, 'mixed host provenance retains spectral with reason')
+
+   mode(2) = ''
+   call auto_impurity_local_host_eligible(.true., active, mode, eligible, reason)
+   call check(.not. eligible .and. index(reason, 'spectral') > 0, 'legacy host provenance retains spectral with reason')
+
+   mode(2) = 'local'
+   call auto_impurity_local_host_eligible(.false., active, mode, eligible, reason)
+   call check(.not. eligible .and. index(reason, 'scope') > 0, 'guarded or unsupported scope remains ineligible')
+
+   active = .false.
+   call auto_impurity_local_host_eligible(.true., active, mode, eligible, reason)
+   call check(.not. eligible .and. index(reason, 'no U-carrying') > 0, 'no-U impurity keeps legacy spectral default')
+   write(*,'(a)') 'RESULT: PASS'
+contains
+   subroutine check(ok, label)
+      logical, intent(in) :: ok
+      character(len=*), intent(in) :: label
+      if (.not. ok) then
+         write(*,'(a)') 'FAIL: '//label
+         error stop 1
+      end if
+   end subroutine check
+end program test_auto_impurity_local_mode

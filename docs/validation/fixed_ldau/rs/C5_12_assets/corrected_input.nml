&calculation
pre_processing = 'newclubulk'
verbose = .true.
/
&lattice
ndim = 50000
rc = 80
alat = 2.86120
crystal_sym = 'bcc'
wav = 1.40880
ntype = 2
ct(:) = 2*3.0d0
r2 = 9.00d0
nclu = 1
inclu(1,:) = 0.0, 0.0, 0.0
/
&atoms
database = './'
label(1) = 'Fe-bulk'
label(2) = 'Fe-imp'
/
&self
nstep = 100
conv_thr = 1.0d-30
use_kspace = .false.
/
&energy
fermi = -0.082949627451487762
energy_min = -0.997797627451487762
energy_max = 0.502202372548512238
channels_ldos = 2500
/
&control
calctype = 'I'
nsp = 1
lld = 21
recur = 'block'
fresh_start = .false.
/
&mix
beta = 0.01
mixtype = 'broyden'
/
&hamiltonian
hubbard_u_impurity(1,3) = 2.0
hubbard_j_impurity(1,3) = 0.0
hubbard_u_potential_form = 'liechtenstein'
hubbard_radial_moments = 'local'
/

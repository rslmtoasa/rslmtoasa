+   module subroutine get_rd4_w1_target_type_mask(this, target_types, status)
+      class(hamiltonian), intent(in) :: this
+      logical, intent(out) :: target_types(:)
+      integer, intent(out) :: status
+      integer :: ia, site, atom_type, mapped_site, map_status
+      logical :: is_recursive_site
+
+      target_types = .false.
+      status = rd4_w1_scope_invalid_map
+      if (.not. associated(this%lattice)) return
+      if (.not. allocated(this%lattice%irec) .or. .not. allocated(this%lattice%iz)) return
+      if (size(target_types) /= this%lattice%ntype .or. size(this%lattice%irec) < 1) return
+
+      do ia = 1, size(this%lattice%irec)
+         call this%get_rd1_recursion_site_type(ia, mapped_site, atom_type, map_status)
+         if (map_status /= rd1_vin_ok) return
+         target_types(atom_type) = .true.
+      end do
+
+      ! hubbard_u_pot is type-shared. A selected recursion type must not also
+      ! occur at a non-recursive host site, or the host would receive W1 too.
+      do site = 1, size(this%lattice%iz)
+         is_recursive_site = any(this%lattice%irec == site)
+         if (is_recursive_site) cycle
+         atom_type = this%lattice%iz(site)
+         if (atom_type < 1 .or. atom_type > size(target_types)) return
+         if (target_types(atom_type)) then
+            status = rd4_w1_scope_shared_host_type
+            return
+         end if
+      end do
+      status = rd4_w1_scope_ok
+   end subroutine get_rd4_w1_target_type_mask

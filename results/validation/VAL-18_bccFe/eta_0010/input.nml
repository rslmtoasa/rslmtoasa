&calculation
post_processing = 'susceptibility'
verbose = T
/
&lattice
rc = 080
alat = 2.86120
crystal_sym = 'bcc'
strux_backend = 'strux_lib'
wav = 1.40880
ntype = 1
ct(1) = 3.0d0
r2 = 9.00d0
/
&atoms
database = './'
label(1) = 'Fe'
/
&self
nstep = 3
use_kspace = .true.
soc_scale = 0.0
fix_soc = .true.
/
&energy
fermi = -0.042265
energy_min = -2.0
energy_max = 0.8
channels_ldos = 2500
/
&reciprocal
nk1 = 8
nk2 = 8
nk3 = 8
k_offset_x = 0.0
k_offset_y = 0.0
k_offset_z = 0.0
use_symmetry_reduction = .true.
use_time_reversal = .true.
use_shift = .false.
q_symmetry_policy = 'full_bz'
dos_method = 'tetrahedron'
temperature = 300.0
auto_find_fermi = .false.
reciprocal_mode = 'ham_only'
/
&control
calctype = 'B'
nsp = 3
lld = 20
recur = 'block'
/
&mix
beta = 0.01
mixtype = 'broyden'
/
&hamiltonian
hoh = .false.
theta_ss = 90.0
/
&tddft
enabled = .true.
channel = 'transverse'
chi0_backend = 'eigenpairs'
xi_backend = 'compare'
response_projection = 'site'
q_mode = 'list'
q_coordinates = 'direct'
goldstone_mode = 'diagnose'
q_list(:,1) = 0.04, 0.0, 0.0
n_q_points = 1
omega_min = 0.0
omega_max = 0.08
nomega = 401
eta = 0.001
electronic_temperature = 300.0
band_first = 1
band_last = 0
occupation_tolerance = 0.0
output_prefix = 'tddft_eta_0010'
output_chi0 = .true.
output_xi = .true.
output_chi = .true.
output_modes = .true.
output_stoner = .true.
/

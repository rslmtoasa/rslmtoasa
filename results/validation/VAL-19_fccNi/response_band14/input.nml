&calculation
pre_processing='none'
post_processing='susceptibility'
verbose=T
/
&lattice
rc=30
alat=6.650
crystal_sym='fcc'
pbc=.true.
n1=16
n2=16
n3=16
wav=1.410
ntype=1
ct(1)=4.0d0
r2=16.0d0
/
&atoms
database='./'
label(1)='Ni'
/
&self
nstep=1
conv_thr=1.0e-9
use_kspace=.true.
soc_scale=0.0d0
fix_soc=.true.
/
&energy
fermi=-0.045779
energy_min=-2.0
energy_max=1.5
channels_ldos=401
/
&reciprocal
nk1=8
nk2=8
nk3=8
k_offset_x=0.0
k_offset_y=0.0
k_offset_z=0.0
use_symmetry_reduction=.false.
use_time_reversal=.false.
dos_method='tetrahedron'
temperature=300.0
auto_find_fermi=.true.
reciprocal_mode='ham_only'
/
&control
calctype='B'
nsp=2
lld=21
recur='block'
/
&mix
beta=0.10
mixtype='broyden'
/
&hamiltonian
hoh=.false.
/
&tddft
enabled=.true.
channel='transverse'
chi0_backend='eigenpairs'
xi_backend='compare'
response_projection='site'
q_mode='list'
q_coordinates='direct'
q_file='../scf_weak/fccNi_qsmall.dat'
omega_min=0.0
omega_max=0.020
nomega=201
eta=0.001
electronic_temperature=300.0
band_first=1
band_last=14
occupation_tolerance=1.0e-14
output_prefix='ni_band14'
output_chi0=.true.
output_xi=.true.
output_chi=.true.
output_modes=.true.
output_stoner=.true.
goldstone_mode='diagnose'
/

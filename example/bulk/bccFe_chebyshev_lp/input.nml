! bcc Fe, real-space Chebyshev recursion with linear prediction (LP) of the moments.
! Same system as example/bulk/bccFe (block recursion). The Chebyshev window must cover the whole
! spectrum of H (energy_min/energy_max below), unlike the Haydock window of the block example.
! lld = 150 gives 302 computed moments; cheb_lp = .true. extends them to cheb_lp_factor*302 = 1208
! before the Jackson-damped reconstruction. Set cheb_lp = .false. for the plain Chebyshev run.
! The log has one 'Chebyshev LP atom ...' line per atom (order p, rank, unstable roots with the
! share of mode amplitude they carry, largest |lambda|, fit residual) and the memory of the moments.
&calculation
pre_processing = 'bravais'
verbose = T
/
&lattice
rc = 080 ! radius cut
alat = 2.86120 ! lattice parameter
crystal_sym = 'bcc'
wav = 1.40880
ntype = 1
ct(1) = 3.0d0
r2 = 9.00d0
/
&atoms
database = './'
label(1) = 'Fe'
/
&self
nstep = 40
/
&energy
fermi = -0.069282
energy_min = -1.2
energy_max = 1.2
channels_ldos = 2500 ! the mesh must resolve pi*a/N_ext, about 0.004 Ry here
/
&control
calctype = 'B'
nsp = 2
lld = 150
recur = 'chebyshev'
cheb_lp = .true.
cheb_lp_factor = 4
/
&mix
beta = 0.01
mixtype = 'broyden'
/

      "nk2": 2,
      "nk3": 2,
      "n_energy_points": 40
    },
    "control": {
      "nsp": 1,
      "recur": "block",
      "lld": 12
    },
    "hamiltonian": {
      "ccor_2c": true
    }
  },
  "checks": {
    "text": [
      {
        "file": "dos_kspace.dat",
        "rows": [
          15,
          21,
          30
        ],
        "cols": [
          1,
          2
        ]
      }
    ]
  }
}
{
  "name": "Example_density_of_states_bccFe",
  "labels": [
    "functional",
    "kspace",
    "dos",
    "basis_spd",
    "scalar_relativistic"
  ],
  "case": "density_of_states/bccFe",
  "timeout": 300,
  "preserve_outputs": true,
  "_note": "Minimal 2x2x2 reciprocal Gaussian DOS fixture. The test pins the actual dos_kspace.dat rows and finite-window DOS diagnostics; its Gaussian broadening/window convention is distinct from the tetrahedron state-count contract.",
  "namelists": {
    "lattice": {
      "strux_backend": "strux_lib"
    },
    "control": {
      "cheb_backend": "legacy",
      "nsp": 1,
      "recur": "block",
      "lld": 12
    },
    "self": {
      "nstep": 1
    },
    "reciprocal": {
      "nk1": 2,
      "nk2": 2,
      "nk3": 2,
      "n_energy_points": 40
    }
  },
  "checks": {
    "nml": [
      {
        "file": "Fe_out.nml",
        "scalars": [
          "etot",
          "ws_r",
          "vmad"
        ]
      }
    ],
    "dimensions": [
      {
        "file": "dos_kspace.dat",
        "data_rows": 40,
        "data_columns": 2
      }
    ],
    "text": [
      {
        "file": "dos_kspace.dat",
        "rows": [
          15,
          21,
          30
        ],
        "cols": [
          1,
          2
        ]
      }
    ],
    "log": [
      {
        "file": "testrun.log",
        "patterns": {
          "canonical_electron_count": "Canonical k-space occupations:.*?N=\\s*([-+0-9.EeDd]+)",
          "canonical_band_energy": "Canonical k-space occupations:.*?EBAND=\\s*([-+0-9.EeDd]+)",
          "dos_integral": "calculate_dos_gaussian: DOS integrates to\\s*([-+0-9.EeDd]+)",
          "dos_electron_count": "k-space energy cross-checks:.*?DOS N=\\s*([-+0-9.EeDd]+)",
          "dos_electron_residual": "k-space energy cross-checks:.*?deltaN=\\s*([-+0-9.EeDd]+)"
        }
      }
    ]
  },
  "outputs": [
    {
      "file": "dos_kspace.dat",
      "min_lines": 48
    }
  ],
  "reference_provenance": {
    "binary": "rslmto.x",
    "cmake_cache": {
      "CMAKE_BUILD_TYPE": "Release",
      "CMAKE_Fortran_COMPILER": "/usr/bin/gfortran",
      "ENABLE_MARCH_NATIVE": "OFF",
      "ENABLE_MKL_KERNELS": "OFF",
      "ENABLE_MPI": "ON"
    },
    "cmake_version": "cmake version 3.31.6",
    "compiler": "/usr/bin/gfortran",
    "compiler_version": "GNU Fortran (Ubuntu 13.3.0-6ubuntu2~24.04.1) 13.3.0\nCopyright (C) 2023 Free Software Foundation, Inc.\nThis is free software; see the source for copying conditions.  There is NO\nwarranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.",
    "git_commit": "4c58bef61727957fe3e72b79b0d11413ce6502c4",
    "mpi_enabled": true,
    "mpi_omp_threads": 1,
    "platform": "Linux-6.17.0-1022-azure-x86_64-with-glibc2.39",
    "profile": "runner-native",
    "serial_omp_threads": 2,
    "underlying_compiler": "unavailable"
  }
}
&calculation
pre_processing = 'none'
post_processing = 'conductivity_p2rs'
verbose = T
/
&lattice
rc = 080
alat = 2.86120
crystal_sym = 'bcc'
wav = 1.40880
pbc = .true.
b1 = .false.
b2 = .false.
b3 = .false.
n1 = 4
n2 = 4
n3 = 4
ntype = 1
ct(1) = 3.0d0
r2 = 9.00d0
/
&atoms
database = './'
label(1) = 'Fe'
/
&self
ws_all = .true.
nstep = 1
/
&hamiltonian
v_alpha = 0, 1, 0
v_beta =  1, 0, 0
js_alpha = 'z'
hoh = false
/
&energy
fermi = -0.042265
energy_min = -2.0
energy_max = 0.8
channels_ldos = 2500
/
&control
calctype = 'B'
nsp = 2
cond_ll = 30
lld = 30
recur = 'chebyshev'
cond_type = 'spin'
cond_calctype = 'per_type'
/
&mix
mixtype = 'broyden'
beta = 0.01
/

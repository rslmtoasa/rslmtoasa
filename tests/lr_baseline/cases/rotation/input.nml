&calculation
pre_processing = 'bravais'
post_processing = 'linear_response'
verbose = F
/
&lattice
rc = 10.0
alat = 2.86120
crystal_sym = 'bcc'
wav = 1.40880
ntype = 1
ct(1) = 3.0d0
r2 = 9.00d0
/
&atoms
database = './'
label(1) = 'Fe'
/
&self
ws_all = .true.
nstep = 2
conv_thr = 1.0
use_kspace = .true.
/
&energy
fermi = -0.371610
energy_min = -1.0
energy_max = 0.5
channels_ldos = 40
/
&control
calctype = 'B'
nsp = 1
lmax = 2
lld = 2
recur = 'block'
fresh_start = .true.
/
&mix
beta = 0.3
mixtype = 'linear'
/
&hamiltonian
hoh = .true.
/
&reciprocal
nk1 = 1
nk2 = 1
nk3 = 1
use_symmetry_reduction = .false.
use_time_reversal = .false.
dos_method = 'tetrahedron'
temperature = 300.0
reciprocal_mode = 'ham_only'
reciprocal_backend = 'lapack'
kspace_ham_order = 'second'
auto_find_fermi = .false.
/
&linear_response
formulation = 'rotation'
q_coordinates = 'direct'
n_q_points = 2
q_list = 0.0, 0.0, 0.0,  0.05, 0.0, 0.0
rotation_axis = 1.0, 0.0, 0.0
finite_h_spectral_mode = 'metallic'
finite_h_response_backend = 'spectral'
native_turek = .true.
native_crosscheck = .false.
native_contour_points = 16
output_file = 'rotation_dynamics.dat'
/

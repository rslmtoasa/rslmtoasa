    {
      "name": "wp6i_ccor_missing_sdot_reject",
      "case": "../scf/cases/frozen_magnon/bccFe",
      "expect_fatal": "gbt_single_q with CCOR requires generated Sdot and strux_want_sdot=.true.",
      "timeout": 300,
      "comment": "WP6b probe, rerun here on the integrated build. ccor_strict is deliberately false: the GBT-specific guard must fire regardless.",
      "namelists": {
        "lattice": {
          "strux_backend": "strux_lib",
          "strux_want_sdot": false,
          "screening": "sigma"
        },
        "control": {
          "nsp": 3,

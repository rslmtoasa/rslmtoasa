{
  "_description": "WP6 integration negative probes: every unsupported GBT combination in feature_matrix.json that can be expressed in an input deck must terminate before the Hamiltonian reaches an eigensolver. Run with run_probes.py.",
  "cases": [
    {
      "name": "wp6i_hubbard_v_reject",
      "case": "../scf/cases/frozen_magnon/bccFe",
      "expect_fatal": "gbt_single_q with intersite Hubbard-V is unsupported",
      "timeout": 300,
      "namelists": {
        "lattice": {
          "strux_backend": "strux_lib",
          "strux_want_sdot": false
        },
        "control": {
          "nsp": 3,
          "recur": "block",
          "lld": 12
        },
        "self": {
          "nstep": 1,
          "use_kspace": true
        },
        "reciprocal": {
          "nk1": 2,
          "nk2": 2,
          "nk3": 2,
          "use_symmetry_reduction": false,
          "use_time_reversal": false,
          "reciprocal_mode": "ham_only"
        },
        "hamiltonian": {
          "hoh": false,
          "theta_ss": 20.0
        },
        "frozen_magnon": {
          "q_file": "q_pm.dat"
        }
      },
      "raw": {
        "hamiltonian": [
          "hubbard_v(1,1,3,3) = 1.0"
        ]
      }
    },
    {
      "name": "wp6i_local_axis_reject",
      "case": "../scf/cases/frozen_magnon/bccFe",

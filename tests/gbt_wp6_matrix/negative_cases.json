          "nk2": 2,
          "nk3": 2,
          "use_symmetry_reduction": false,
          "use_time_reversal": false,
          "reciprocal_mode": "ham_only"
        },
        "hamiltonian": {
          "hoh": false,
          "theta_ss": 20.0,
          "ccor_2c": true,
          "ccor_elin": 0.25,
          "ccor_vmt_mode": "vmad_scalar",
          "ccor_strict": false
        },
        "frozen_magnon": {
          "q_file": "q_pm.dat"
        }
      }
    },
    {
      "name": "wp7_periodic_nc_qss_reject",
      "case": "../scf/cases/k_space_scf/bccFe",
      "expect_fatal": "q_ss is set but magnetic_representation=periodic_nc",
      "timeout": 300,
      "comment": "WP7 input-boundary guard. A spiral wavevector under the DEFAULT periodic_nc representation is never read, so the sweep would return the same collinear answer at every q. Deliberately uses an ordinary SCF deck, not frozen_magnon: post_processing='frozen_magnon' forces magnetic_representation=gbt_single_q itself, so the guard cannot and must not fire there.",
      "namelists": {
        "control": {
          "nsp": 3,
          "recur": "block",
          "lld": 12
        },
        "self": {
          "nstep": 1
        },
        "hamiltonian": {
          "hoh": false,
          "theta_ss": 20.0
        }
      },
      "raw": {
        "hamiltonian": [
          "q_ss(:) = 0.0d0, 0.0d0, 0.25d0"
        ]
      }
    }
  ]

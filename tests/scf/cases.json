{
  "_description": "Test case matrix for example SCF tests. Single source of truth — CMakeLists reads this file. Optional manifest defaults are recursively merged into each case's 'namelists' before applying the f90nml patch.",
  "defaults": {
    "namelists": {
      "lattice": { "strux_backend": "strux_lib" },
      "control": { "cheb_backend": "legacy" }
    }
  },
  "cases": [
    {
      "name": "Example_bulk_diamondSi_sp_chebyshev",
      "labels": ["functional", "scf", "rs", "chebyshev", "basis_sp", "nonmagnetic", "strux"],
      "case": "bulk/diamondSi",
      "timeout": 300,
      "abs_tol": 1e-6,
      "rel_tol": 1e-6,
      "_note": "TEST-06/07: deterministic nonmagnetic diamond-Si sp fixture. Explicit strux_lib, periodic 12x12x12 Bravais geometry, one SCF step, 200 Chebyshev moments. The 12^3 replication is retained for a stable DOS shape and remains a lean backend fixture; runtime/reference provenance is recorded in the fixture README. This is not a converged Si benchmark and is intentionally not quick.",
      "namelists": {
        "lattice":    { "strux_backend": "strux_lib" },
        "control":    { "nsp": 1, "lmax": 1, "recur": "chebyshev", "cheb_backend": "legacy", "lld": 200 },
        "self":       { "nstep": 1 },
        "hamiltonian": { "hoh": false }
      },
      "checks": {
        "nml": [
          { "file": "Si1_out.nml", "scalars": ["lmax", "etot", "ws_r", "vmad"] }
        ],
        "text": [
          { "file": "totaldos.out", "rows": [100, 500, 1000, 1500, 1900], "cols": [1, 2] },
          { "file": "Si1_dos.out", "rows": [100, 500, 1000, 1500, 1900], "cols": [1, 2] }
        ],
        "log": [
          { "file": "testrun.log", "patterns": { "fermi_level": "Free Fermi energy:\\s*([-+0-9.EeDd]+)" } }
        ]
      },
      "outputs": [
        { "file": "totaldos.out", "min_lines": 100 },
        { "file": "Si1_dos.out", "min_lines": 100 }
      ]
    },
    {
      "name": "Example_bulk_bccFe_nsp2_block_hoh",
      "quick": true,
      "labels": ["functional", "rs", "metallic", "magnetic", "basis_spd", "block", "hoh"],
      "case": "bulk/bccFe",
      "timeout": 300,
      "omp_threads": 2,
      "abs_tol": 1e-6,
      "rel_tol": 1e-6,
      "namelists": {
        "control":     { "nsp": 2, "recur": "block", "lld": 20 },
        "self":        { "nstep": 1 },
        "hamiltonian": { "hoh": true }
      },
      "checks": {
        "nml": [
          { "file": "Fe_out.nml", "scalars": ["etot", "ws_r"], "arrays": { "mom": [3] } }

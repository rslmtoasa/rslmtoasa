{
  "_description": "Test case matrix for example SCF tests. Single source of truth — CMakeLists reads this file. The 'namelists' dict is applied verbatim as an f90nml patch on top of each case's input.nml.",
  "cases": [
    {
      "name": "Example_bulk_bccFe_nsp2_block_hoh",
      "case": "bulk/bccFe",
      "timeout": 300,
      "omp_threads": 2,
      "abs_tol": 1e-6,
      "rel_tol": 1e-6,
      "namelists": {
        "control":     { "nsp": 2, "recur": "block", "lld": 20 },
        "self":        { "nstep": 1 },
        "hamiltonian": { "hoh": true }
      },
      "checks": {
        "nml": [
          { "file": "Fe_out.nml", "scalars": ["etot", "ws_r"], "arrays": { "mom": [3] } }
        ],
        "text": [
          { "file": "totaldos.out", "rows": [500, 1000, 1500], "cols": [1, 2] }
        ]
      }
    },

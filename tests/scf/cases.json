{
  "_description": "Test case matrix for example SCF tests. Single source of truth \u2014 CMakeLists reads this file. Optional manifest defaults are recursively merged into each case's 'namelists' before applying the f90nml patch.",
  "defaults": {
    "namelists": {
      "lattice": {
        "strux_backend": "strux_lib"
      },
      "control": {
        "cheb_backend": "legacy"
      }

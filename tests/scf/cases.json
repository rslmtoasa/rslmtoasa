    {
      "name": "Example_bulk_bccFe_nsp2_block_hoh",
      "labels": [
        "functional",
        "rs",
        "metallic",
        "magnetic",
        "basis_spd",
        "block",
        "hoh"
      ],
      "case": "bulk/bccFe",
      "timeout": 300,
      "omp_threads": 2,
      "abs_tol": 1e-06,
      "rel_tol": 1e-06,
      "namelists": {
        "control": {
          "nsp": 2,
          "recur": "block",
          "lld": 20
        },
        "self": {
          "nstep": 1
        },
        "hamiltonian": {
          "hoh": true
        }

! Diamond-Si sp-basis Chebyshev functional fixture.
&calculation
  pre_processing = 'bravais'
  verbose = T
/
&lattice
  rc = 50
  alat = 5.443702
  crystal_sym = 'file'
  wav = 1.4962757958
  pbc = .true.
  b1 = .true.
  b2 = .true.
  b3 = .true.
  n1 = 12
  n2 = 12
  n3 = 12
  ntype = 2
  ct(:) = 2*4.0d0
  r2 = 16.0d0
  strux_backend = 'strux_lib'
/
&atoms
  database = './'
  label(1) = 'Si1'
  label(2) = 'Si2'
/
&self
  nstep = 1
  cold = .true.
/
&energy
  fermi = 0.015615
  energy_min = -1.5
  energy_max = 1.0
  channels_ldos = 2000
/
&control
  calctype = 'B'
  nsp = 1
  lld = 200
  recur = 'chebyshev'
  cheb_backend = 'fast'
  lmax = 1
/
&mix
  beta = 0.1
  mixtype = 'broyden'
/
&hamiltonian
  hoh = .false.
/

{
  "name": "Example_bulk_diamondSi_sp_chebyshev_mkl_batch",
  "labels": [
    "functional",
    "scf",
    "rs",
    "chebyshev",
    "basis_sp",
    "nonmagnetic",
    "strux"
  ],
  "case": "bulk/diamondSi",
  "timeout": 600,
  "requires_cmake_option": "ENABLE_MKL_KERNELS",
  "_note": "TEST-07: backend-only MKL batch coverage uses the canonical diamond-Si sp fixture; reference provenance is recorded in the fixture README.",
  "namelists": {
    "lattice": {
      "strux_backend": "strux_lib"
    },
    "control": {
      "nsp": 1,
      "lmax": 1,
      "recur": "chebyshev",
      "cheb_backend": "mkl_batch",
      "lld": 200
    },
    "self": {
      "nstep": 1
    },
    "hamiltonian": {
      "hoh": false
    }
  },
  "checks": {
    "nml": [
      {
        "file": "Si1_out.nml",
        "scalars": [
          "lmax",
          "etot",
          "ws_r",
          "vmad"
        ]
      }
    ],
    "text": [
      {
        "file": "totaldos.out",
        "rows": [
          100,
          500,
          1000,
          1500,
          1900
        ],
        "cols": [
          1,
          2
        ]
      }
    ]
  },
  "outputs": [
    {
      "file": "totaldos.out",
      "min_lines": 100
    },
    {
      "file": "Si1_dos.out",
      "min_lines": 100
    }
  ]
}

{
  "name": "Example_bulk_diamondSi_sp_chebyshev",
  "labels": [
    "functional",
    "scf",
    "rs",
    "chebyshev",
    "basis_sp",
    "nonmagnetic",
    "strux"
  ],
  "case": "bulk/diamondSi",
  "timeout": 300,
  "abs_tol": 1e-06,
  "rel_tol": 1e-06,
  "_note": "TEST-06/07: deterministic nonmagnetic diamond-Si sp fixture. Explicit strux_lib, periodic 12x12x12 Bravais geometry, one SCF step, 200 Chebyshev moments. The 12^3 replication is retained for a stable DOS shape and remains a lean backend fixture; runtime/reference provenance is recorded in the fixture README. This is not a converged Si benchmark and is intentionally not quick.",
  "namelists": {
    "lattice": {
      "strux_backend": "strux_lib"
    },
    "control": {
      "cheb_backend": "legacy",
      "nsp": 1,
      "lmax": 1,
      "recur": "chebyshev",
      "lld": 200
    },
    "self": {
      "nstep": 1
    },
    "hamiltonian": {
      "hoh": false
    }
  },
  "checks": {
    "nml": [
      {
        "file": "Si1_out.nml",
        "scalars": [
          "lmax",
          "etot",
          "ws_r",
          "vmad"
        ]
      }
    ],
    "text": [
      {
        "file": "totaldos.out",
        "rows": [
          100,
          500,
          1000,
          1500,
          1900
        ],
        "cols": [
          1,
          2
        ]
      },
      {
        "file": "Si1_dos.out",
        "rows": [
          100,
          500,
          1000,
          1500,
          1900
        ],
        "cols": [
          1,
          2
        ]
      }
    ],
    "log": [
      {
        "file": "testrun.log",
        "patterns": {
          "fermi_level": "Free Fermi energy:\\s*([-+0-9.EeDd]+)"
        }
      }
    ]
  },
  "outputs": [
    {
      "file": "totaldos.out",
      "min_lines": 100
    },
    {
      "file": "Si1_dos.out",
      "min_lines": 100
    }
  ],
  "reference_provenance": {
    "binary": "rslmto.x",
    "cmake_cache": {
      "CMAKE_BUILD_TYPE": "Release",
      "CMAKE_Fortran_COMPILER": "/opt/homebrew/bin/gfortran",
      "ENABLE_MARCH_NATIVE": "OFF",
      "ENABLE_MKL_KERNELS": "OFF",
      "ENABLE_MPI": "ON"
    },
    "cmake_version": "cmake version 4.3.4",
    "compiler": "/opt/homebrew/bin/gfortran",
    "compiler_version": "GNU Fortran (Homebrew GCC 16.1.0) 16.1.0\nCopyright (C) 2026 Free Software Foundation, Inc.\nThis is free software; see the source for copying conditions.  There is NO\nwarranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.",
    "git_commit": "4c58bef61727957fe3e72b79b0d11413ce6502c4",
    "mpi_enabled": true,
    "mpi_omp_threads": 1,
    "platform": "macOS-14.8.7-arm64-arm-64bit",
    "profile": "runner-native",
    "serial_omp_threads": 2,
    "underlying_compiler": "unavailable"
  }
}
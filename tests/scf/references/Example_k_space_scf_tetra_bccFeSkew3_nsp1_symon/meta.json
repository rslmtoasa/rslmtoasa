{
  "name": "Example_k_space_scf_tetra_bccFeSkew3_nsp1_symon",
  "labels": [
    "functional",
    "scf",
    "kspace",
    "dos",
    "tetrahedron",
    "basis_spd",
    "nonmagnetic",
    "strux",
    "mpi"
  ],
  "case": "k_space_scf/bccFeSkew3",
  "timeout": 300,
  "launch_modes": [
    "serial",
    "mpi"
  ],
  "mpi_procs": 2,
  "mpi_rank_counts": [
    2
  ],
  "_note": "Sym-on twin of Example_k_space_scf_tetra_bccFeSkew3_nsp1: same deck with use_symmetry_reduction=.true.; its reference is a copy of the sym-off reference, compared at abs/rel 1e-8.",
  "namelists": {
    "lattice": {
      "strux_backend": "strux_lib"
    },
    "control": {
      "cheb_backend": "legacy",
      "nsp": 1,
      "lmax": 2,
      "recur": "block",
      "lld": 12
    },
    "self": {
      "nstep": 1,
      "use_kspace": true
    },
    "reciprocal": {
      "nk1": 4,
      "nk2": 4,
      "nk3": 4,
      "use_symmetry_reduction": true,
      "use_time_reversal": true,
      "n_energy_points": 400,
      "dos_method": "tetrahedron",
      "gaussian_sigma": 0.01
    },
    "energy": {
      "channels_ldos": 400,
      "energy_min": -2.0,
      "energy_max": 2.0
    }
  },
  "checks": {
    "nml": [
      {
        "file": "Fe_out.nml",
        "scalars": [
          "lmax",
          "etot",
          "ws_r",
          "vmad"
        ],
        "arrays": {
          "mom": [
            3
          ],
          "lmom": [
            3
          ]
        }
      }
    ],
    "text": [
      {
        "file": "totaldos.out",
        "rows": [
          120,
          200,
          280
        ],
        "cols": [
          1,
          2
        ]
      },
      {
        "file": "band_moments.dat",
        "rows": [
          11,
          12,
          13,
          14,
          15,
          16,
          17,
          18
        ],
        "cols": [
          4,
          5,
          6
        ]
      }
    ],
    "finite": [
      {
        "file": "totaldos.out",
        "cols": [
          1,
          2
        ]
      }
    ],
    "log": [
      {
        "file": "testrun.log",
        "patterns": {
          "site_spin_moment_1": "Spin moment of atom\\s+1 is\\s+([-+0-9.EeDd]+)",
          "site_spin_moment_2": "Spin moment of atom\\s+2 is\\s+([-+0-9.EeDd]+)",
          "site_spin_moment_3": "Spin moment of atom\\s+3 is\\s+([-+0-9.EeDd]+)",
          "site_valence_1": "Valence at atom\\s+1 is\\s+([-+0-9.EeDd]+)",
          "site_valence_3": "Valence at atom\\s+3 is\\s+([-+0-9.EeDd]+)",
          "fermi_level": "Canonical k-space occupations: EF=\\s*([-+0-9.EeDd]+)",
          "canonical_band_energy": "Canonical k-space occupations:.*?EBAND=\\s*([-+0-9.EeDd]+)"
        }
      },
      {
        "file": "report.out",
        "patterns": {
          "site_occupation_1": "Occupation at atom\\s+1:\\s*([-+0-9.EeDd]+)",
          "site_occupation_3": "Occupation at atom\\s+3:\\s*([-+0-9.EeDd]+)"
        }
      }
    ]
  },
  "outputs": [
    {
      "file": "totaldos.out",
      "min_lines": 400
    },
    {
      "file": "magneticdos.out",
      "min_lines": 401
    },
    {
      "file": "report.out",
      "min_lines": 3
    },
    {
      "file": "minfo.out",
      "min_lines": 1
    },
    {
      "file": "linfo.out",
      "min_lines": 1
    }
  ],
  "tier": "quick",
  "abs_tol": 1e-08,
  "rel_tol": 1e-08,
  "reference_provenance": {
    "binary": "rslmto.x",
    "cmake_cache": {
      "CMAKE_BUILD_TYPE": "Release",
      "CMAKE_Fortran_COMPILER": "/usr/bin/gfortran",
      "ENABLE_MARCH_NATIVE": "OFF",
      "ENABLE_MKL_KERNELS": "OFF",
      "ENABLE_MPI": "ON"
    },
    "cmake_version": "cmake version 3.28.3",
    "compiler": "/usr/bin/gfortran",
    "compiler_version": "GNU Fortran (Ubuntu 13.3.0-6ubuntu2~24.04.1) 13.3.0\nCopyright (C) 2023 Free Software Foundation, Inc.\nThis is free software; see the source for copying conditions.  There is NO\nwarranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.",
    "git_commit": "65df50132bbe78eae74c6114f69083f2c2e03a02",
    "mpi_enabled": true,
    "mpi_omp_threads": 1,
    "platform": "Linux-6.18.44-fc-v726-x86_64-with-glibc2.39",
    "profile": "runner-native",
    "serial_omp_threads": 2,
    "underlying_compiler": "unavailable"
  }
}
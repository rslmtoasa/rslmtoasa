    "control": {
      "nsp": 2,
      "recur": "lanczos",
      "lld": 20
    },
    "self": {
      "nstep": 1
    },
    "hamiltonian": {
      "hoh": true
    }
  },
  "checks": {
    "nml": [
      {
        "file": "Fe_out.nml",
        "scalars": [
          "etot",
          "ws_r"
        ],
        "arrays": {
          "mom": [
            3
          ]
        }
      }
    ]
  }
}
{
  "name": "Example_bulk_bccFe_nsp2_lanczos_hoh",
  "case": "bulk/bccFe",
  "timeout": 300,
  "_note": "totaldos.out/lmom are NaN for recur=lanczos at nsp=2 (KNOWN_ISSUES.md); only scalar/mom checks until fixed",

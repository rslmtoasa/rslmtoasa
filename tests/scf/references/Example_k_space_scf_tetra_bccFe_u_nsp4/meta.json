    "lattice": {
      "strux_backend": "strux_lib"
    },
    "control": {
      "cheb_backend": "legacy",
      "nsp": 4,
      "lmax": 2,
      "recur": "block",
      "lld": 12
    },
    "self": {
      "nstep": 2,
      "use_kspace": true
    },
    "reciprocal": {
      "nk1": 4,
      "nk2": 4,
      "nk3": 4,
      "use_symmetry_reduction": false,
      "use_time_reversal": true,
      "n_energy_points": 400,
      "dos_method": "tetrahedron",
      "gaussian_sigma": 0.01

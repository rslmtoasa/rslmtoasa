{
  "name": "Example_k_space_scf_bccFe",
  "quick": true,
  "labels": [
    "functional",
    "scf",
    "kspace",
    "magnetic",
    "basis_spd",
    "strux"
  ],
  "case": "k_space_scf/bccFe",
  "timeout": 300,
  "launch_modes": [
    "serial",
    "mpi"
  ],
  "mpi_procs": 2,
  "mpi_rank_counts": [
    1,
    2,
    4
  ],
  "namelists": {
    "lattice": {
      "strux_backend": "strux_lib"
    },
    "control": {
      "cheb_backend": "legacy",
      "nsp": 1,
      "recur": "block",
      "lld": 12
    },
    "self": {
      "nstep": 1,
      "use_kspace": true
    },
    "reciprocal": {
      "nk1": 2,
      "nk2": 2,
      "nk3": 2,
      "n_energy_points": 40,
      "dos_method": "gaussian",
      "gaussian_sigma": 0.01
    },
    "energy": {
      "energy_min": -2.0,
      "energy_max": 2.0
    }
  },
  "checks": {
    "nml": [
      {
        "file": "Fe_out.nml",
        "scalars": [
          "etot",
          "ws_r",
          "vmad"
        ],
        "arrays": {
          "mom": [
            3
          ],
          "lmom": [
            3
          ]
        }
      }
    ],
    "text": [
      {
        "file": "totaldos.out",
        "rows": [
          800,
          1255,
          1700
        ],
        "cols": [
          1,
          2
        ]
      }
    ],
    "log": [
      {
        "file": "testrun.log",
        "patterns": {
          "fermi_level": "Canonical k-space occupations: EF=\\s*([-+0-9.EeDd]+)",
          "canonical_electron_count": "Canonical k-space occupations:.*? Ry, N=\\s*([-+0-9.EeDd]+)",
          "canonical_band_energy": "Canonical k-space occupations:.*?EBAND=\\s*([-+0-9.EeDd]+)",
          "dos_integral": "DOS integrates to\\s*([-+0-9.EeDd]+)",
          "site_spin_moment": "Spin moment of atom\\s+1 is\\s+([-+0-9.EeDd]+)",
          "site_valence": "Valence at atom\\s+1 is\\s+([-+0-9.EeDd]+)",
          "site_charge_transfer_z": "Charge transfer at atom\\s+1:\\s+[-+0-9.EeDd]+\\s+[-+0-9.EeDd]+\\s+([-+0-9.EeDd]+)"
        }
      }
    ]
  },
  "outputs": [
    {
      "file": "totaldos.out",
      "min_lines": 50
    },
    {
      "file": "magneticdos.out",
      "min_lines": 51
    },
    {
      "file": "report.out",
      "min_lines": 10
    },
    {
      "file": "minfo.out",
      "min_lines": 1
    },
    {
      "file": "linfo.out",
      "min_lines": 1
    }
  ],
  "reference_provenance": {
    "binary": "rslmto.x",
    "cmake_cache": {
      "CMAKE_BUILD_TYPE": "Release",
      "CMAKE_Fortran_COMPILER": "/opt/homebrew/bin/gfortran-13",
      "ENABLE_MARCH_NATIVE": "OFF",
      "ENABLE_MKL_KERNELS": "OFF",
      "ENABLE_MPI": "OFF"
    },
    "cmake_version": "cmake version 4.4.2",
    "compiler": "/opt/homebrew/bin/gfortran-13",
    "compiler_version": "GNU Fortran (Homebrew GCC 13.4.0) 13.4.0\nCopyright (C) 2023 Free Software Foundation, Inc.\nThis is free software; see the source for copying conditions.  There is NO\nwarranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.",
    "git_commit": "4c58bef61727957fe3e72b79b0d11413ce6502c4",
    "mpi_enabled": false,
    "mpi_omp_threads": 1,
    "platform": "macOS-26.5.2-arm64-arm-64bit",
    "profile": "runner-native",
    "serial_omp_threads": 2,
    "underlying_compiler": "unavailable"
  }
}
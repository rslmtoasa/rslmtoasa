&gbt_tolerances
  eig_identity_ry   = 1.0d-10  ! a-priori round-off estimate: LAPACK backward error, matrix order <= 200, |H| ~ 1 Ry
  omega_identity_ry = 1.0d-10  ! a-priori round-off estimate: mesh sums up to 160^3 points, per cell
  n_identity        = 1.0d-10  ! a-priori round-off estimate, as omega_identity_ry
  model_eig_ry      = 1.0d-12  ! O1; generator self-checks <= 3.3e-16 Ry
  model_ft_rel      = 1.0d-6   ! O2; |Richardson(0.25, 0.5, 1 deg) DeltaOmega/sin^2(theta) - (J(0)-J(q))| / max_q |J(0)-J(q)|
                               ! demonstrated <= 2.3e-8; targeted bugs (E_F*DeltaN mixing) give 0.66-100 on this scale
/


&calculation
! B5.2 sigma (KPM conductivity) route triad base input. The runner patches
! calculation%gf_route to recursion | lehmann | dyson. recursion fills
! mu_nm_stochastic the legacy way; lehmann/dyson fill the SAME array EXACTLY from
! the k-space eigenpairs (reciprocal%fill_moments, B5.1), so
! calculate_conductivity_tensor runs unchanged. Sigma=0: lehmann == dyson.
post_processing = 'conductivity'
gf_route = 'recursion'
verbose = T
/
&lattice
rc = 080
alat = 2.86120
crystal_sym = 'bcc'
wav = 1.40880
pbc = .true.
b1 = .false.
b2 = .false.
b3 = .false.
n1 = 20
n2 = 20
n3 = 20
ntype = 1
ct(1) = 3.0d0
r2 = 9.0d0
/
&atoms
database = './'
label(1) = 'Fe'
/
&self
nstep = 100
/
&hamiltonian
! Diagonal sigma_xx (v_alpha == v_beta): a large nonzero component both routes
! resolve. The off-diagonal (Hall) sigma_xy is a symmetry-forced zero without SOC
! and is coarse-mesh noise -- not a route-agnostic observable to pin.
v_alpha = 1, 0, 0
v_beta = 1, 0, 0
/
&energy
fermi = -0.069099
energy_min = -1.0
energy_max = 1.2
channels_ldos = 2500
/
&control
calctype = 'B'
nsp = 2
! Small cond_ll keeps the exact k-space moment generator (cond_ll^2 * nb^2 * nmat
! per k) CI-tractable; the triad pins route agreement, not the converged sigma.
cond_ll = 30
lld = 150
recur = 'chebyshev'
cond_type = 'charge'
cond_calctype = 'per_type'
/
&reciprocal
nk1 = 6
nk2 = 6
nk3 = 6
use_symmetry_reduction = .false.
/
&mix
beta = 0.1
mixtype = 'broyden'
/

{
  "_description": "Regression backend matrix. Optional manifest defaults are recursively merged into each case's 'namelists' before patching the base input.nml. References were generated from the trusted pre-refactor build.",
  "defaults": {
    "namelists": {
      "lattice": { "strux_backend": "strux_lib" }
    }
  },
  "cases": [
    {
      "name": "bccFe_chebyshev_fast",
      "base": "bccFe_chebyshev",
      "labels": ["validation"],
      "timeout": 300,
      "namelists": {
        "control": { "recur": "chebyshev", "cheb_backend": "fast", "lld": 30 },
        "hamiltonian": { "hoh": false, "ccor_2c": false }
      }
    },
    {
      "name": "bccFe_chebyshev_batched",
      "base": "bccFe_chebyshev",
      "timeout": 300,
      "namelists": {
        "control": { "recur": "chebyshev", "cheb_backend": "batched", "lld": 30 },
        "hamiltonian": { "hoh": false, "ccor_2c": false }
      }
    },
    {
      "name": "bccFe_chebyshev_mkl_batch",
      "base": "bccFe_chebyshev",
      "timeout": 300,
      "requires_cmake_option": "ENABLE_MKL_KERNELS",
      "namelists": {
        "control": { "recur": "chebyshev", "cheb_backend": "mkl_batch", "lld": 30 },
        "hamiltonian": { "hoh": false, "ccor_2c": false }
      }
    },
    {
      "name": "bccFe_chebyshev_mkl_sparse",
      "base": "bccFe_chebyshev",
      "timeout": 300,
      "requires_cmake_option": "ENABLE_MKL_KERNELS",
      "namelists": {
        "control": { "recur": "chebyshev", "cheb_backend": "mkl_sparse", "lld": 30 },
        "hamiltonian": { "hoh": false, "ccor_2c": false }
      }
    },
    {
      "name": "bccFe_chebyshev_legacy",
      "base": "bccFe_chebyshev",
      "timeout": 300,
      "namelists": {
        "control": { "recur": "chebyshev", "cheb_backend": "legacy", "lld": 30 },
        "hamiltonian": { "hoh": false, "ccor_2c": false }
      }
    },
    {
      "name": "bccFe_chebyshev_fast_hoh",
      "base": "bccFe_chebyshev",
      "timeout": 300,
      "namelists": {
        "control": { "recur": "chebyshev", "cheb_backend": "fast", "lld": 30 },
        "energy": { "energy_min": -3.0, "energy_max": 1.8 },
        "hamiltonian": { "hoh": true, "ccor_2c": false }
      }
    },
    {
      "name": "bccFe_chebyshev_legacy_hoh",
      "base": "bccFe_chebyshev",
      "timeout": 300,
      "namelists": {
        "control": { "recur": "chebyshev", "cheb_backend": "legacy", "lld": 50 },
        "energy": { "energy_min": -3.0, "energy_max": 1.8 },
        "hamiltonian": { "hoh": true, "ccor_2c": false }
      }
    },
    {
      "name": "bccFe_chebyshev_fast_ccor_2c",
      "base": "bccFe_chebyshev",
      "_note": "ccor_2c requires derivative structure constants; use the supported strux_lib fitted-screening/Sdot mode from example/bulk/bccFe/CCOR.",
      "timeout": 300,
      "namelists": {
        "lattice": { "strux_backend": "strux_lib", "screening": "fitted", "strux_want_sdot": true },
        "control": { "recur": "chebyshev", "cheb_backend": "fast", "lld": 30 },
        "hamiltonian": { "hoh": false, "ccor_2c": true }
      }
    },
    {
      "name": "bccFe_block_fast_sp",
      "base": "bccFe_block",
      "labels": ["legacy_strux"],
      "_note": "Explicit legacy structure-constant sentinel; the normal regression default is strux_lib.",
      "timeout": 300,
      "namelists": {
        "lattice": { "strux_backend": "legacy" },
        "control": { "recur": "block", "cheb_backend": "fast", "lld": 16 },
        "hamiltonian": { "hoh": false, "ccor_2c": false }
      }
    },
    {
      "name": "bccFe_block_fast_dp",
      "base": "bccFe_block",
      "timeout": 300,
      "namelists": {
        "control": { "recur": "block", "cheb_backend": "fast_dp", "lld": 16 },
        "hamiltonian": { "hoh": false, "ccor_2c": false }
      }
    }
  ]
}

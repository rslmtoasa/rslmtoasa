{
  "_description": "Regression backend matrix. Optional manifest defaults are recursively merged into each case's 'namelists' before patching the base input.nml. Backend-only Chebyshev rows use the shared diamond-Si sp fixture; magnetic and composition-specific rows remain on Fe.",
  "defaults": {
    "namelists": {
      "lattice": {
        "strux_backend": "strux_lib"
      }
    }
  },
  "cases": [
    {
      "name": "diamondSi_sp_chebyshev_fast",
      "base": "../scf/cases/bulk/diamondSi",
      "output_file": "Si1_out.nml",
      "labels": [
        "functional",
        "rs",
        "chebyshev",
        "basis_sp",
        "nonmagnetic"
      ],
      "timeout": 300,
      "namelists": {
        "control": {
          "nsp": 1,
          "lmax": 1,
          "recur": "chebyshev",
          "cheb_backend": "fast",
          "lld": 200
        },
        "hamiltonian": {
          "hoh": false,
          "ccor_2c": false
        }
      },
      "tier": "standard"
    },
    {
      "name": "diamondSi_sp_chebyshev_batched",
      "base": "../scf/cases/bulk/diamondSi",
      "output_file": "Si1_out.nml",
      "labels": [
        "functional",
        "rs",
        "chebyshev",
        "basis_sp",
        "nonmagnetic"
      ],
      "timeout": 300,
      "namelists": {
        "control": {
          "nsp": 1,
          "lmax": 1,
          "recur": "chebyshev",
          "cheb_backend": "batched",
          "lld": 200
        },
        "hamiltonian": {
          "hoh": false,
          "ccor_2c": false
        }
      },
      "tier": "standard"
    },
    {
      "name": "diamondSi_sp_chebyshev_mkl_batch",
      "base": "../scf/cases/bulk/diamondSi",
      "output_file": "Si1_out.nml",
      "labels": [
        "functional",
        "rs",
        "chebyshev",
        "basis_sp",
        "nonmagnetic"
      ],
      "timeout": 300,
      "requires_cmake_option": "ENABLE_MKL_KERNELS",
      "namelists": {
        "control": {
          "nsp": 1,
          "lmax": 1,
          "recur": "chebyshev",
          "cheb_backend": "mkl_batch",
          "lld": 200
        },
        "hamiltonian": {
          "hoh": false,
          "ccor_2c": false
        }
      },

      "base": "../scf/cases/bulk/diamondSi",
      "output_file": "Si1_out.nml",
      "labels": [
        "functional",
        "rs",
        "chebyshev",
        "basis_sp",
        "nonmagnetic"
      ],
      "timeout": 300,
      "namelists": {
        "control": {
          "nsp": 1,
          "lmax": 1,
          "recur": "chebyshev",
          "cheb_backend": "legacy",
          "lld": 200
        },
        "hamiltonian": {
          "hoh": false,
          "ccor_2c": false
        }
      },
      "tier": "standard"

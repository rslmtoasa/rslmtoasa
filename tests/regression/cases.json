{
  "_description": "Regression backend matrix. Each case patches the base test input.nml, runs rslmto.x, and compares Fe_out.nml to references generated from the trusted pre-refactor build.",
  "cases": [
    {
      "name": "bccFe_chebyshev_fast",
      "base": "bccFe_chebyshev",
      "timeout": 300,
      "namelists": {
        "control": { "recur": "chebyshev", "cheb_backend": "fast", "lld": 30 },
        "hamiltonian": { "hoh": false, "ccor_2c": false }
      }
    },
    {
      "name": "bccFe_chebyshev_batched",
      "base": "bccFe_chebyshev",
      "timeout": 300,
      "namelists": {
        "control": { "recur": "chebyshev", "cheb_backend": "batched", "lld": 30 },
        "hamiltonian": { "hoh": false, "ccor_2c": false }
      }
    },
    {
      "name": "bccFe_chebyshev_mkl_batch",
      "base": "bccFe_chebyshev",

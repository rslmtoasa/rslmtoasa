! TDDFT-11 fcc Ni: native G(R,z) -> chi0(R,omega) selected-point deck.
&calculation
pre_processing = 'none'
post_processing = 'susceptibility'
verbose = T
/
&lattice
rc = 030
alat = 6.650
crystal_sym = 'fcc'
pbc = .true.
n1 = 4
n2 = 4
n3 = 4
wav = 1.410
ntype = 1
ct(1) = 4.0d0
r2 = 16.0d0
/
&atoms
database = '../../../../../results/validation/VAL-19_fccNi/scf_weak/'
label(1) = 'Ni'
/
&self
nstep = 1
conv_thr = 1.0e-9
use_kspace = .true.
soc_scale = 0.0d0
fix_soc = .true.
/
&energy
fermi = -0.045779
energy_min = -2.0
energy_max = 1.5
channels_ldos = 401
/
&reciprocal
nk1 = 4
nk2 = 4
nk3 = 4
k_offset_x = 0.0
k_offset_y = 0.0
k_offset_z = 0.0
use_symmetry_reduction = .false.
use_time_reversal = .false.
dos_method = 'tetrahedron'
temperature = 300.0
auto_find_fermi = .true.
reciprocal_mode = 'ham_only'
/
&control
calctype = 'B'
nsp = 1
lld = 21
recur = 'block'
/
&mix
beta = 0.10
mixtype = 'broyden'
/
&hamiltonian
hoh = .false.
/
&tddft
enabled = .true.
channel = 'transverse'
chi0_backend = 'realspace_gf'
xi_backend = 'legacy_site_scalar'
response_projection = 'site'
q_mode = 'list'
q_coordinates = 'direct'
q_file = 'q_selected.dat'
omega_min = 0.0
omega_max = 0.002
nomega = 3
eta = 0.0005
electronic_temperature = 300.0
band_first = 1
band_last = 0
green_eta = 0.00025
realspace_rmax = 30.0
realspace_tail_tolerance = 1.0e-3
realspace_fourier_axes = 1, 2, 3
realspace_representation = 'bulk'
output_prefix = 'tddft11_ni_realspace_gf'
output_chi0 = .true.
output_xi = .false.
output_chi = .false.
output_modes = .false.
output_stoner = .true.
goldstone_mode = 'diagnose'
/

! TDVAL-01 fcc Ni ground-state provenance deck.
! Lengths in the input convention are Angstrom; wav is the ASA Wigner-Seitz radius.
&calculation
pre_processing = 'bravais'
verbose = T
/
&lattice
rc = 030
alat = 3.520
crystal_sym = 'fcc'
pbc = .true.
b1 = .true.
b2 = .true.
b3 = .true.
n1 = 16
n2 = 16
n3 = 16
wav = 1.410
ntype = 1
ct(1) = 5.0d0
r2 = 25.0d0
strux_backend = 'strux_lib'
/
&atoms
database = './'
label(1) = 'Ni'
/
&self
nstep = 80
conv_thr = 1.0e-9
use_kspace = .true.
soc_scale = 0.0d0
fix_soc = .true.
/
&energy
fermi = 0.1010233902012761
energy_min = -2.0
energy_max = 1.5
channels_ldos = 401
/
&reciprocal
nk1 = 16
nk2 = 16
nk3 = 16
k_offset_x = 0.0
k_offset_y = 0.0
k_offset_z = 0.0
use_symmetry_reduction = .false.
use_time_reversal = .false.
dos_method = 'tetrahedron'
temperature = 300.0
auto_find_fermi = .true.
reciprocal_mode = 'ham_only'
/
&control
calctype = 'B'
nsp = 2
lld = 21
recur = 'block'
/
&mix
beta = 0.10
mixtype = 'broyden'
/
&hamiltonian
hoh = .false.
/

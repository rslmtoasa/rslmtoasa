&calculation
pre_processing = 'none'
post_processing = 'frozen_magnon'
verbose = T
/
&lattice
rc = 080 ! radius cut. We could think about setting a default
alat = 2.86120 ! lattice parameter
crystal_sym = 'bcc' ! options are bcc, fcc and hcp so far.
strux_backend = 'strux_lib'
wav = 1.40880
ntype = 1
ct(1) = 3.0d0
r2 = 9.00d0
/
&atoms
database = './'
label(1) = 'Fe'
/
&self
nstep = 3
use_kspace = .false.
/
&energy
fermi = -0.042265
energy_min = -2.0
energy_max = 0.8
channels_ldos = 2500
/
&control
calctype = 'B'
nsp = 3
lld = 21
recur = 'block'
/
&mix
beta = 0.01
mixtype = 'broyden'
/
&hamiltonian
hoh = .false.
theta_ss = 90.0
/
&frozen_magnon
mode = 'mft'
q_file = 'q_points.dat'
q_coordinates = 'cartesian'
/

&calculation
pre_processing = 'bravais'
/
&lattice
! ndim/rc are chosen so the spherical cut (radius sqrt(rc) = 8 alat) sits well
! inside the pre-cut translation box on BOTH sides of the pair -- see the
! header of tests/regression/run_gbt_supercell.py.
ndim = 60000
rc = 64.0
alat = 2.86120
crystal_sym = 'bcc'
wav = 1.40880
ntype = 1
ct(1:1) = 1*3.0d0
r2 = 9.00d0
! WP4: gbt_single_q is rejected fatally on the legacy backend
! (hamiltonian_build.f90::build_gbt_bulkham) -- required, not optional.
strux_backend = 'strux_lib'
/
&atoms
database = './'
label(1) = 'Fe'
/
&self
ws_all = .true.
! Force-theorem comparison (plan section 3.2): one band evaluation on a frozen
! potential, E_F re-found at fixed electron number. beta = 1.0 makes the output
! ql the raw band charges, so per-site charge/moment are read at full precision.
nstep = 1
/
&energy
fermi = -0.069933
energy_min = -1.0
energy_max = 0.5
channels_ldos = 2500
/
&control
calctype = 'B'
nsp = 3
lld = 16
recur = 'block'
/
&hamiltonian
q_ss(:) = 0.0d0, 0.0d0, 0.5d0
theta_ss = 90.0d0
! WP3/WP5: the representation is explicit and defaults to periodic_nc, under
! which q_ss is stored but never read (tests/KNOWN_ISSUES.md,
! "nsp4_block_spiral_qplus/_qminus never enable GBT"). Plain bulk SCF
! (pre_processing='bravais') does not auto-force this the way
! post_processing_frozen_magnon{,_auto} does -- it must be set here.
magnetic_representation = 'gbt_single_q'
/
&mix
beta = 1.0
mixtype = 'linear'
! magbeta = 0 freezes the moment DIRECTIONS at their input values. On the
! supercell side those directions are the hand-set lab-frame spiral; they are
! also the local quantisation axes for the ql spin decomposition, so they must
! not drift.
magbeta(1:1) = 1*0.0d0
/

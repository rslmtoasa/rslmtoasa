&calculation
pre_processing = 'bravais'
/
&lattice
! ndim/rc are chosen so the spherical cut (radius sqrt(rc) = 8 alat) sits well
! inside the pre-cut translation box on BOTH sides of the pair -- see the
! header of tests/regression/run_gbt_supercell.py.
ndim = 60000
rc = 64.0
alat = 2.86120
crystal_sym = 'file'
wav = 1.40880
ntype = 6
ct(1:6) = 6*3.0d0
r2 = 9.00d0
/
&atoms
database = './'
label(1) = 'Fe1'
label(2) = 'Fe2'
label(3) = 'Fe3'
label(4) = 'Fe4'
label(5) = 'Fe5'
label(6) = 'Fe6'
/
&self
ws_all = .true.
! Force-theorem comparison (plan section 3.2): one band evaluation on a frozen
! potential, E_F re-found at fixed electron number. beta = 1.0 makes the output
! ql the raw band charges, so per-site charge/moment are read at full precision.
nstep = 1
/
&energy
fermi = -0.069933
energy_min = -1.0
energy_max = 0.5
channels_ldos = 2500
/
&control
calctype = 'B'
nsp = 3
lld = 16
recur = 'block'
/
&hamiltonian
q_ss(:) = 0.0d0, 0.0d0, 0.0d0
theta_ss = 0.0d0
/
&mix
beta = 1.0
mixtype = 'linear'
! magbeta = 0 freezes the moment DIRECTIONS at their input values. On the
! supercell side those directions are the hand-set lab-frame spiral; they are
! also the local quantisation axes for the ql spin decomposition, so they must
! not drift.
magbeta(1:6) = 6*0.0d0
/

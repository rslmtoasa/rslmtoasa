! Minimal accepted-state Juelich-d static identity check.
! One SCF acceptance is followed by direct use of that live reciprocal cache.
&calculation
pre_processing = 'bravais'
post_processing = 'linear_response'
verbose = F
/
&lattice
rc = 080
alat = 2.86120
crystal_sym = 'bcc'
wav = 1.40880
ntype = 1
ct(1) = 3.0d0
r2 = 9.00d0
/
&atoms
database = '../../scf/cases/bulk/bccFe/'
label(1) = 'Fe'
/
&self
nstep = 50
conv_thr = 1.0e-6
use_kspace = .true.
/
&energy
fermi = -0.062245
energy_min = -2.0
energy_max = 0.8
channels_ldos = 401
/
&control
calctype = 'B'
nsp = 1
lld = 21
recur = 'block'
/
&mix
beta = 0.01
mixtype = 'broyden'
/
&hamiltonian
hoh = .true.
/
&reciprocal
nk1 = 4
nk2 = 4
nk3 = 4
k_offset_x = 0.0
k_offset_y = 0.0
k_offset_z = 0.0
use_symmetry_reduction = .false.
use_time_reversal = .false.
use_shift = .false.
dos_method = 'tetrahedron'
temperature = 300.0
auto_find_fermi = .false.
reciprocal_mode = 'ham_only'
reciprocal_backend = 'lapack'
kspace_ham_order = 'second'
/
&linear_response
formulation = 'projected'
representation = 'radial_points'
bare_response = 'lehmann'
interaction = 'lcmm'
projection = 'd'
diagnostics = 'none'
channel = 'chi_plus'
n_q = 1
q_list = 0.0, 0.0, 0.0
n_omega = 1
use_omega_grid = .false.
omega_min = 0.0
omega_max = 0.0
eta = 0.04
n_eta = 8
eta_grid = 0.04, 0.02, 0.01, 0.005, 0.0025, 0.00125, 0.000625, 0.0003125
response_lmax = -1
write_full_matrix = .false.
output_file = 'juelich_d_identity.dat'
/

&calculation
pre_processing = 'bravais'
post_processing = 'none'
verbose = F
/
&lattice
rc = 050
alat = 2.86120
crystal_sym = 'bcc'
wav = 1.40880
ntype = 1
ct(1) = 3.0d0
r2 = 9.00d0
/
&atoms
database = './'
label(1) = 'Fe'
/
&self
ws_all = .true.
nstep = 2
conv_thr = 1.0
/
&energy
fermi = -0.371610
energy_min = -1.0
energy_max = 0.5
channels_ldos = 40
/
&control
calctype = 'B'
nsp = 1
lmax = 1
lld = 4
recur = 'lanczos'
fresh_start = .true.
/
&mix
beta = 0.3
mixtype = 'linear'
/
&hamiltonian
hoh = .true.
/
&reciprocal
nk1 = 1
nk2 = 1
nk3 = 1
use_symmetry_reduction = .false.
use_time_reversal = .false.
dos_method = 'tetrahedron'
temperature = 300.0
reciprocal_mode = 'ham_only'
reciprocal_backend = 'lapack'
kspace_ham_order = 'second'
auto_find_fermi = .false.
/

&calculation
pre_processing = 'bravais'
post_processing = 'tddft'
verbose = F
/
&lattice
rc = 080
alat = 2.86120
crystal_sym = 'bcc'
wav = 1.40880
ntype = 1
ct(1) = 3.0d0
r2 = 9.00d0
/
&atoms
database = '../../scf/cases/bulk/bccFe/'
label(1) = 'Fe'
/
&self
nstep = 50
conv_thr = 1.0e-6
/
&energy
fermi = -0.085121
energy_min = -2.0
energy_max = 0.8
channels_ldos = 2500
/
&control
calctype = 'B'
nsp = 1
lld = 21
recur = 'block'
/
&mix
beta = 0.01
mixtype = 'broyden'
/
&hamiltonian
hoh = .true.
/
&reciprocal
nk1 = 8
nk2 = 8
nk3 = 8
k_offset_x = 0.0
k_offset_y = 0.0
k_offset_z = 0.0
use_symmetry_reduction = .false.
use_time_reversal = .false.
use_shift = .false.
dos_method = 'tetrahedron'
temperature = 300.0
auto_find_fermi = .false.
reciprocal_mode = 'ham_only'
reciprocal_backend = 'lapack'
kspace_ham_order = 'second'
/
&tddft
enabled = .true.
channel = 'chi_plus'
n_q = 2
! Gamma and the TDVK-04-certified finite q=(0.125,0,0).
q_list = 0.0, 0.0, 0.0,  0.125, 0.0, 0.0
n_omega = 2
use_omega_grid = .true.
omega_grid = 0.00, 0.02
omega_min = 0.00
omega_max = 0.02
eta = 0.01
n_eta = 1
eta_grid = 0.01
response_lmax = -1
interaction_route = 'direct_alsda'
goldstone_correction = .false.
backend = 'product_convergence'
gf_integration_points = 6401
gf_integration_eta = 0.001
gf_energy_margin = 0.60
write_full_matrix = .false.
output_file = 'tddft_tdvk05_fe.dat'
/

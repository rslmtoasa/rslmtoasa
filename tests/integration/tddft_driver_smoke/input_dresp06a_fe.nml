! DRESP-06A bounded bcc-Fe spatial ALSDA same-state comparison fixture.
&calculation
pre_processing = 'bravais'
post_processing = 'tddft'
verbose = F
/
&lattice
rc = 080
alat = 2.86120
crystal_sym = 'bcc'
wav = 1.40880
ntype = 1
ct(1) = 3.0d0
r2 = 9.00d0
/
&atoms
database = '../../scf/cases/bulk/bccFe/'
label(1) = 'Fe'
/
&self
nstep = 50
conv_thr = 1.0e-6
use_kspace = .true.
/
&energy
fermi = -0.062245
energy_min = -2.0
energy_max = 0.8
channels_ldos = 401
/
&control
calctype = 'B'
nsp = 1
lld = 21
recur = 'block'
/
&mix
beta = 0.01
mixtype = 'broyden'
/
&hamiltonian
hoh = .true.
/
&reciprocal
nk1 = 4
nk2 = 4
nk3 = 4
k_offset_x = 0.0
k_offset_y = 0.0
k_offset_z = 0.0
use_symmetry_reduction = .false.
use_time_reversal = .false.
use_shift = .false.
dos_method = 'tetrahedron'
temperature = 300.0
auto_find_fermi = .false.
reciprocal_mode = 'ham_only'
reciprocal_backend = 'lapack'
kspace_ham_order = 'second'
/
&tddft
enabled = .true.
channel = 'chi_plus'
n_q = 4
! Gamma plus one exactly commensurate 4x4x4 grid step and its negative.
! The old q=0.03 point is retained only as a noncommensurate diagnostic.
q_list = 0.0, 0.0, 0.0,  0.25, 0.0, 0.0,  -0.25, 0.0, 0.0,  0.03, 0.0, 0.0
n_omega = 9
use_omega_grid = .false.
omega_min = 0.0
omega_max = 0.20
eta = 0.02
n_eta = 4
eta_grid = 0.04, 0.02, 0.01, 0.005
response_lmax = -1
interaction_route = 'direct_alsda'
goldstone_correction = .false.
backend = 'alsda_compare'
projected_selector = 'spd'
! The ALSDA closure computes the base/fine odd Simpson counts from span and
! gf_integration_eta; this input value is retained as a provenance hint only.
gf_integration_points = 9561
gf_integration_eta = 0.001
gf_energy_margin = 0.60
gf_closure_audit = .true.
validate_interacting_covariance = .true.
write_full_matrix = .false.
output_file = '/tmp/dresp06a_fe_4k.dat'
/

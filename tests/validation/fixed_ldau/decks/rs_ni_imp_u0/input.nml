&calculation
pre_processing = 'newclubulk'
verbose = T
/
&lattice
rc = 060 ! radius cut. We could think about setting a default
alat =  3.52340 ! lattice parapeter
crystal_sym = 'fcc' ! options are bcc, fcc and hcp so far.
pbc = T
b1 = T
b2 = T
b3 = T
n1 = 16
n2 = 16
n3 = 16
ntype    = 2
ct(:) = 2*4.0
r2 = 16.0
wav = 1.37692
nclu = 1
inclu(1, :) = 0.0, 0.0, 0.0
/
&atoms
database = './'
label(1) = 'Ni'
label(2) = 'Ni-imp'
/
&self
ws_all = .true. ! ''
nstep = 400
conv_thr = 1.0e-8
soc_scale = 0.0
fix_soc = .true.
/
&energy
fermi = -0.063637
energy_min = -1.0
energy_max = 1.5
channels_ldos = 2500
/
&control
calctype = 'I'
nsp = 2 ! type of calculation, nsp can be 1, 2, 3 or 4
lld = 150
recur = 'chebyshev'
/
&mix
beta = 0.05
ldm_beta = 0.3
mixtype = 'broyden'
/
&hamiltonian
hubbard_spinor_dm_diagnostic = .true.
hubbard_log_level = 'detailed'
hubbard_u_general(1,3) = 0.0
hubbard_j_general(1,3) = 0.0
hubbard_u_general(2,3) = 0.0
hubbard_j_general(2,3) = 0.0
/

&calculation
pre_processing = 'bravais'
verbose = T
/
&lattice
rc = 080
alat = 2.86120
crystal_sym = 'bcc'
wav = 1.40880
ntype = 1
ct(1) = 3.0d0
r2 = 9.00d0
/
&atoms
database = './'
label(1) = 'Fe'
/
&self
nstep = 300
conv_thr = 1.0e-8
soc_scale = 0.0
fix_soc = .true.
/
&energy
fermi = -0.042265
energy_min = -1.0
energy_max = 1.3
channels_ldos = 2500
/
&control
calctype = 'B'
nsp = 2
lld = 150
recur = 'chebyshev'
/
&mix
beta = 0.01
mixtype = 'broyden'
/
&hamiltonian
hubbard_radial_moments = 'local'
hubbard_spinor_dm_diagnostic = .true.
hubbard_log_level = 'detailed'
hoh = .false.
hubbard_u_general(1,3) = 2.0
hubbard_j_general(1,3) = 0.0
/
